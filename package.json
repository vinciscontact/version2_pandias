{
  "name": "hotel-pandias-v2",
  "private": true,
  "description": "Hotel Pandia's website, QR table ordering and staff app (plain HTML/CSS/JS). Only the staff app and the 3D worker need a build.",
  "scripts": {
    "build:staff": "esbuild app=src/staff-app.js --bundle --splitting --format=esm --minify --target=es2022 --outdir=staff --chunk-names=chunks/[name]-[hash]",
    "build:mascot": "esbuild src/mascot-worker.js --bundle --format=iife --minify --target=es2022 --outfile=js/mascot-worker.js",
    "build:pages": "python tools/build-menu.py && python tools/build-order.py",
    "serve": "python -m http.server 4400"
  },
  "devDependencies": {
    "@supabase/supabase-js": "2.117.2",
    "esbuild": "0.28.2",
    "jspdf": "3.0.1",
    "jspdf-autotable": "5.0.2",
    "three": "0.186.1"
  }
}
